# Mayhem target: map_read — upstream's own test-crates/protobuf-fuzz/fuzz/fuzz_targets/map_read.rs, built by
# mayhem/build.sh via cargo-fuzz at /mayhem/map_read. Fuzzes: parse_from_reader (BufReader path) on TestTypesMap.
# No local seed corpus is shipped (upstream's fuzz/ ships none, gitignored corpus/artifacts dirs
# only) — the server-accumulated testsuite.tar is the sole seed source.
project: savantenvs/rust-protobuf
target: map-read
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
cmds:
  - cmd: /mayhem/map_read
    libfuzzer: true
