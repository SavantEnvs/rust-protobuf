# Mayhem target: empty_message_read — upstream's own test-crates/protobuf-fuzz/fuzz/fuzz_targets/empty_message_read.rs, built by
# mayhem/build.sh via cargo-fuzz at /mayhem/empty_message_read. Fuzzes: parse_from_reader (BufReader path) on EmptyMessage.
# No local seed corpus is shipped (upstream's fuzz/ ships none, gitignored corpus/artifacts dirs
# only) — the server-accumulated testsuite.tar is the sole seed source.
project: savantenvs/rust-protobuf
target: empty-message-read
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
cmds:
  - cmd: /mayhem/empty_message_read
    libfuzzer: true
