# Mayhem target: singular — upstream's own test-crates/protobuf-fuzz/fuzz/fuzz_targets/singular.rs, built by
# mayhem/build.sh via cargo-fuzz at /mayhem/singular. Fuzzes: parse_from_bytes on TestTypesSingular (one field of every scalar/enum/nested-message kind).
# No local seed corpus is shipped (upstream's fuzz/ ships none, gitignored corpus/artifacts dirs
# only) — the server-accumulated testsuite.tar is the sole seed source.
project: savantenvs/rust-protobuf
target: singular
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
cmds:
  - cmd: /mayhem/singular
    libfuzzer: true
