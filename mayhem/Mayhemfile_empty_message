# Mayhem target: empty_message — upstream's own test-crates/protobuf-fuzz/fuzz/fuzz_targets/empty_message.rs, built by
# mayhem/build.sh via cargo-fuzz at /mayhem/empty_message. Fuzzes: parse_from_bytes on the zero-field EmptyMessage type (tag/length skipping, unknown-field handling).
# No local seed corpus is shipped (upstream's fuzz/ ships none, gitignored corpus/artifacts dirs
# only) — the server-accumulated testsuite.tar is the sole seed source.
project: savantenvs/rust-protobuf
target: empty-message
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
cmds:
  - cmd: /mayhem/empty_message
    libfuzzer: true
