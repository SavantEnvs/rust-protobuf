# Mayhem target: singular_read — upstream's own test-crates/protobuf-fuzz/fuzz/fuzz_targets/singular_read.rs, built by
# mayhem/build.sh via cargo-fuzz at /mayhem/singular_read. Fuzzes: parse_from_reader (BufReader path) on TestTypesSingular.
# No local seed corpus is shipped (upstream's fuzz/ ships none, gitignored corpus/artifacts dirs
# only) — the server-accumulated testsuite.tar is the sole seed source.
project: savantenvs/rust-protobuf
target: singular-read
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
cmds:
  - cmd: /mayhem/singular_read
    libfuzzer: true
