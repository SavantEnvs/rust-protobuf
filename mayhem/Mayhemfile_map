# Mayhem target: map — upstream's own test-crates/protobuf-fuzz/fuzz/fuzz_targets/map.rs, built by
# mayhem/build.sh via cargo-fuzz at /mayhem/map. Fuzzes: parse_from_bytes on TestTypesMap (map fields over every key/value type combination).
# No local seed corpus is shipped (upstream's fuzz/ ships none, gitignored corpus/artifacts dirs
# only) — the server-accumulated testsuite.tar is the sole seed source.
project: savantenvs/rust-protobuf
target: map
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
cmds:
  - cmd: /mayhem/map
    libfuzzer: true
